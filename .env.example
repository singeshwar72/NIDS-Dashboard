# NIDS SOC Dashboard — Environment Variables
# Copy this file to .env and customize before running.

# Flask secret key (CHANGE THIS in production)
SECRET_KEY=nids-dev-secret-change-in-production

# Flask environment: development | production
FLASK_ENV=development

# Enable debug mode (set to False in production)
DEBUG=True

# SQLite database path
DATABASE_PATH=nids.db

# Upload folder (relative to project root)
UPLOAD_FOLDER=uploads

# Maximum upload size in megabytes
MAX_UPLOAD_MB=10

# Page size for API pagination
PAGE_SIZE=50

# Demo monitoring refresh interval (seconds)
MONITOR_INTERVAL=5

# Detection thresholds (optional overrides)
HIGH_CONN_THRESHOLD=50
HIGH_PACKET_RATE_THRESHOLD=1000.0
HIGH_BYTES_THRESHOLD=10000000
